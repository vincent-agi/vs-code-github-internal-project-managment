{
  "name": "remote-project-manager",
  "displayName": "Remote Project Manager",
  "description": "View and manage GitHub and GitLab Issues and Milestones from a central panel in VS Code.",
  "version": "0.0.1",
  "publisher": "local-dev",
  "icon": "media/plugin-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincent-agi/vs-code-github-internal-project-managment.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remoteProjectManager.openPanel",
        "title": "Remote Project Manager: Open Panel"
      }
    ],
    "configuration": {
      "title": "Remote Project Manager",
      "properties": {
        "remoteProjectManager.provider": {
          "type": "string",
          "enum": [
            "github",
            "gitlab"
          ],
          "default": "github",
          "description": "Remote platform to connect to."
        },
        "remoteProjectManager.repository": {
          "type": "string",
          "default": "",
          "description": "Repository or project path, e.g. 'owner/repo'."
        },
        "remoteProjectManager.cacheTtlSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "description": "How long issue/milestone/capability reads are cached before refetching, in seconds. Use the panel's Refresh button to bypass the cache immediately."
        },
        "remoteProjectManager.autoBranchOnInProgress": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create and check out a git branch when an issue assigned to you moves to 'in-progress'. When off, a suggested branch name is shown instead."
        },
        "remoteProjectManager.branchNamePattern": {
          "type": "string",
          "default": "${type}/${issue_id}-${slug}",
          "description": "Pattern for auto-created branch names. Placeholders: ${type} (inferred from labels, e.g. fix/feature/docs/issue), ${issue_id} (issue number), ${slug} (sanitized title)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && tsc -p tsconfig.webview.json",
    "watch": "tsc -w -p .",
    "watch:webview": "tsc -w -p tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "@octokit/rest": "^22.0.1",
    "simple-git": "^3.36.0"
  }
}
